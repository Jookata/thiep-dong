<resources>
    <!-- app_name lấy từ values/strings.xml -->
    <string name="main_title">選擇賀卡</string>
    <string name="main_sub">製作動態賀卡，透過聊天或簡訊傳送。</string>
    <string name="cat_xmas">聖誕節</string>
    <string name="cat_birthday">生日</string>
    <string name="cat_newyear">新年</string>
    <string name="cat_empty">此分類的更多賀卡即將推出！</string>
    <string name="tpl_noel_title">聖誕賀卡：森林之夜</string>
    <string name="tpl_noel_desc">收卡人自己探索：點亮小木屋、種出聖誕樹、迎接飄雪，就能收到帶有自己名字的祝福。</string>
    <string name="tpl_santa_title">聖誕賀卡：睡過頭的聖誕老人</string>
    <string name="tpl_santa_desc">用一桶水喚醒微醺的聖誕老人，找到拉雪橇的馴鹿，裝上禮物，從煙囪送出去。</string>
    <string name="tpl_catch_title">聖誕賀卡：接禮物</string>
    <string name="tpl_catch_desc">聖誕老人飛過灑下禮物，移動襪子接住 9 個，大禮盒就會打開，露出給收件人的祝福。</string>
    <string name="tpl_flappy_title">聖誕賀卡：飛行雪橇</string>
    <string name="tpl_flappy_desc">點擊螢幕讓馴鹿雪橇飛過松樹和熟睡的馴鹿。通過 5 關後，聖誕老人會丟下禮物，並送上給收件人的祝福。</string>
    <string name="tpl_birthday_title">生日賀卡：驚喜盒子</string>
    <string name="tpl_birthday_desc">選對禮盒找到蛋糕，插上蠟燭、點亮再吹熄。生日歌響起，生日賀卡緩緩出現。</string>
    <string name="tpl_yuki_title">日式雪景聖誕</string>
    <string name="tpl_yuki_desc">翻開一頁，靜謐的日式雪景與你的祝福一同出現。</string>
    <string name="tpl_nen_title">生日蠟燭</string>
    <string name="tpl_nen_desc">吹熄燃燒的蠟燭，生日祝福與生日歌便會出現。</string>
    <string name="tpl_newyear_title">新年零點</string>
    <string name="tpl_newyear_desc">點一下零點的時鐘，煙火綻放，新年祝福隨之出現。</string>
    <string name="tpl_korea_title">韓國雪夜聖誕</string>
    <string name="tpl_korea_desc">把男孩、女孩和小狗叫到韓國的雪地庭院裡，迎來祝福。</string>
    <string name="btn_use">使用此賀卡</string>
