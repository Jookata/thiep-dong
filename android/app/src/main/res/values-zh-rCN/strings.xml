<resources>
    <!-- app_name lấy từ values/strings.xml -->
    <string name="main_title">选择贺卡</string>
    <string name="main_sub">制作动态贺卡，通过聊天或短信发送。</string>
    <string name="cat_xmas">圣诞节</string>
    <string name="cat_birthday">生日</string>
    <string name="cat_newyear">新年</string>
    <string name="cat_empty">此分类的更多贺卡即将推出！</string>
    <string name="tpl_noel_title">圣诞贺卡：森林之夜</string>
    <string name="tpl_noel_desc">收卡人自己探索：点亮小木屋、种出圣诞树、迎接飘雪，就能收到带有自己名字的祝福。</string>
    <string name="tpl_santa_title">圣诞贺卡：睡过头的圣诞老人</string>
    <string name="tpl_santa_desc">用一桶水唤醒微醺的圣诞老人，找到拉雪橇的驯鹿，装上礼物，从烟囱送出去。</string>
    <string name="tpl_catch_title">圣诞贺卡：接礼物</string>
    <string name="tpl_catch_desc">圣诞老人飞过撒下礼物，移动袜子接住 9 个，大礼盒就会打开，露出给收件人的祝福。</string>
    <string name="tpl_flappy_title">圣诞贺卡：飞行雪橇</string>
    <string name="tpl_flappy_desc">点击屏幕让驯鹿雪橇飞过松树和熟睡的驯鹿。通过 5 关后，圣诞老人会扔下礼物，并送上给收件人的祝福。</string>
    <string name="tpl_birthday_title">生日贺卡：惊喜盒子</string>
    <string name="tpl_birthday_desc">选对礼盒找到蛋糕，插上蜡烛、点亮再吹灭。生日歌响起，生日贺卡缓缓出现。</string>
    <string name="tpl_yuki_title">日式雪景圣诞</string>
    <string name="tpl_yuki_desc">翻开一页，静谧的日式雪景与你的祝福一同出现。</string>
    <string name="tpl_nen_title">生日蜡烛</string>
    <string name="tpl_nen_desc">吹灭燃烧的蜡烛，生日祝福与生日歌便会出现。</string>
    <string name="tpl_newyear_title">新年零点</string>
    <string name="tpl_newyear_desc">点一下零点的时钟，烟花绽放，新年祝福随之出现。</string>
    <string name="tpl_korea_title">韩国雪夜圣诞</string>
    <string name="tpl_korea_desc">把男孩、女孩和小狗叫到韩国的雪地庭院里，迎来祝福。</string>
    <string name="btn_use">使用此贺卡</string>
