<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- app_name lấy từ values/strings.xml -->
    <string name="main_title">카드 고르기</string>
    <string name="main_sub">움직이는 카드를 만들어 메신저나 문자로 보내 보세요.</string>
    <string name="cat_xmas">크리스마스</string>
    <string name="cat_birthday">생일</string>
    <string name="cat_newyear">새해</string>
    <string name="cat_empty">이 카테고리의 카드가 곧 추가됩니다!</string>
    <string name="tpl_noel_title">크리스마스 카드: 숲속의 밤</string>
    <string name="tpl_noel_desc">받는 사람이 직접 탐험해요: 오두막에 불을 켜고, 나무를 키우고, 눈을 맞이하면 이름이 담긴 인사말이 나와요.</string>
    <string name="tpl_santa_title">크리스마스 카드: 늦잠 잔 산타 할아버지</string>
    <string name="tpl_santa_desc">물 한 양동이로 취한 산타 할아버지를 깨우고, 썰매를 끌 순록을 찾아 선물을 싣고 굴뚝으로 배달해요.</string>
    <string name="tpl_catch_title">크리스마스 카드: 선물 받기</string>
    <string name="tpl_catch_desc">산타 할아버지가 선물을 떨어뜨려요. 양말을 움직여 9개를 받으면 큰 선물 상자가 열리며 받는 사람에게 인사말이 나타나요.</string>
    <string name="tpl_flappy_title">크리스마스 카드: 하늘을 나는 썰매</string>
    <string name="tpl_flappy_desc">화면을 터치해 순록 썰매를 전나무와 잠든 순록 사이로 날려요. 5번 통과하면 산타가 선물을 떨어뜨리고 받는 사람에게 인사말을 전해요.</string>
    <string name="tpl_birthday_title">생일 카드: 깜짝 선물 상자</string>
    <string name="tpl_birthday_desc">알맞은 상자를 골라 케이크를 찾고, 초를 꽂아 불을 붙인 뒤 불어서 끄세요. 생일 축하 노래와 함께 축하 카드가 나타나요.</string>
    <string name="tpl_yuki_title">일본풍 눈 내리는 크리스마스</string>
    <string name="tpl_yuki_desc">페이지를 넘기면 고요한 눈 내리는 일본 풍경과 함께 인사가 나타나요.</string>
    <string name="tpl_nen_title">생일 촛불</string>
    <string name="tpl_nen_desc">타오르는 촛불을 불어 끄면 생일 축하 메시지와 노래가 나타나요.</string>
    <string name="tpl_newyear_title">새해 자정</string>
    <string name="tpl_newyear_desc">자정의 시계를 터치하면 불꽃놀이와 새해 인사가 나타나요.</string>
    <string name="tpl_korea_title">한국 눈 내리는 크리스마스</string>
    <string name="tpl_korea_desc">소년, 소녀, 강아지를 눈 덮인 한옥 마당으로 불러 보세요.</string>
    <string name="btn_use">이 카드 사용</string>
    <string name="create_title">카드 만들기</string>
    <string name="hint_to">받는 사람 이름</string>
    <string name="hint_from">내 이름 (보내는 사람)</string>
    <string name="hint_msg">개인 메시지 (선택)</string>
    <string name="lang_label">카드 언어</string>
    <string name="btn_preview">미리보기</string>
    <string name="btn_share">카드 공유</string>
    <string name="btn_copy">링크 복사</string>
    <string name="copied">링크가 복사되었습니다</string>
    <string name="share_chooser">카드 보내기</string>
</resources>
